(access_log) {
	log {
		output file /srv/logs/caddy-access.log
	}
}

{$DOMAIN:localhost} {
	import access_log

	@htmx {
		method GET
		path /
		header HX-Request true
	}
	log_skip @htmx

	@stats path /stats/* /ws
	basic_auth @stats {
		admin {$STATS_PASSWORD_HASH}
	}

	handle / {
		root * /srv
		rewrite * /index.html
		templates
		file_server
	}
	handle /favicon.ico {
		respond 204
	}
	handle /cover.jpg {
		root * /srv/covers
		file_server
	}
	handle /ws {
		reverse_proxy goaccess:7890
	}
	handle {
		reverse_proxy icecast:8000 {
			header_up -Range
			flush_interval -1
		}
	}
}

http://{$DOMAIN:localhost} {
	import access_log
	handle /admin* {
		reverse_proxy icecast:8000
	}
	handle /stream {
		reverse_proxy icecast:8000 {
			header_up -Range
			flush_interval -1
		}
	}
	handle /favicon.ico {
		respond 204
	}
	handle /cover.jpg {
		root * /srv/covers
		file_server
	}
	handle / {
		root * /srv
		rewrite * /index.html
		templates
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}
