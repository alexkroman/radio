{$DOMAIN:localhost} {
	log {
		output file /logs/caddy-access.log
	}

	@stats path /stats/* /ws/*
	basic_auth @stats {
		admin {$STATS_PASSWORD_HASH}
	}

	handle / {
		root * /srv
		rewrite * /index.html
		templates
		file_server
	}
	handle /ws/access {
		reverse_proxy goaccess:443 {
			transport http
		}
	}
	handle {
		reverse_proxy icecast:8000 {
			flush_interval -1
		}
	}
}
