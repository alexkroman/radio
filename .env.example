# Copy to .env and fill in:   cp .env.example .env
# (.env is git-ignored; the stack refuses to start until these are set.)

# Admin password: Icecast admin at /admin/ and the stats page at /stats/ (user "admin" for both).
PASSWORD=change-me

# Separate password for live shows from BUTT (port 8005, user "source"). It travels
# unencrypted, so keep it different from PASSWORD and only give it to DJs.
LIVE_PASSWORD=change-me-too

# Your public domain; Caddy gets an HTTPS certificate for it automatically.
# Leave commented out to run on https://localhost.
#DOMAIN=radio.example.com
