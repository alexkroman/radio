# Copy to .env and fill in:   cp .env.example .env
# (.env is git-ignored; the stack refuses to start until these are set.)

# Icecast password: source/relay/admin credentials Liquidsoap uses to publish the
# stream. Icecast is never exposed publicly, so nobody types this in a browser.
PASSWORD=change-me

# Admin site at /admin (user "admin"): SoundExchange reports.
ADMIN_PASSWORD=change-me-admin

# Your domain; Caddy gets a trusted Let's Encrypt certificate automatically.
# Leave commented out to run on https://localhost.
#DOMAIN=radio.example.com

# Namecheap Dynamic DNS password (from Advanced DNS → Dynamic DNS in Namecheap dashboard).
# Used to keep the domain's A record pointing at your home IP. Required by compose.
DDNS_PASSWORD=change-me-ddns

# Time zone for reports.
#TZ=America/New_York
