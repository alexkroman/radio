# Copy to .env and fill in:   cp .env.example .env
# (.env is git-ignored; the stack refuses to start until these are set.)

# Icecast password: admin interface at /admin/ (user "admin") plus the source and
# relay credentials Liquidsoap uses to publish the stream. This is full control of
# the broadcast — keep it to yourself.
PASSWORD=change-me

# Stats page only: HTTP basic-auth for the goaccess analytics at /stats/ (user
# "admin"). Kept separate from PASSWORD so this read-only, browser-typed credential
# can't unlock Icecast admin if it leaks. Caddy never sees PASSWORD.
STATS_PASSWORD=change-me-stats

# Separate password for live shows from BUTT (port 8005, user "source"). It travels
# unencrypted, so keep it different from PASSWORD and only give it to DJs.
LIVE_PASSWORD=change-me-too

# Your domain; Caddy gets a trusted Let's Encrypt certificate automatically.
# Leave commented out to run on https://localhost.
#DOMAIN=radio.example.com

# Namecheap Dynamic DNS password (from Advanced DNS → Dynamic DNS in Namecheap dashboard).
# Used to keep the domain's A record pointing at your home IP.
#DDNS_PASSWORD=
