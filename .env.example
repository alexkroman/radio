# Copy to .env and fill in:   cp .env.example .env
# (.env is git-ignored; the stack refuses to start until these are set.)

# One password for everything: BUTT/live shows (user "source"),
# Icecast admin at /admin/ (user "admin") and the stats page at /stats/ (user "admin").
PASSWORD=change-me

# The stats login needs a hash of that same password. Generate it with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ signs.
STATS_PASSWORD_HASH='paste-the-hash-here'

# Your public domain; Caddy gets an HTTPS certificate for it automatically.
# Leave commented out to run on https://localhost.
#DOMAIN=radio.example.com
