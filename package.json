  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@picocss/pico": "2.1.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "htmx.org": "2.0.11",
    "icecast-metadata-player": "1.17.13",
    "jiti": "2.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
