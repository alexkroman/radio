{$DOMAIN:localhost} {
	log {
		output file /srv/logs/caddy-access.log
	}

	@htmx {
		method GET
		path /
		header HX-Request true
	}
	log_skip @htmx

	@stats path /stats/* /ws
	basic_auth @stats {
		admin {$STATS_PASSWORD_HASH}
	}

	handle / {
		root * /srv
		rewrite * /index.html
		templates
		file_server
	}
	handle /ws {
		reverse_proxy goaccess:7890
	}
	handle {
		reverse_proxy icecast:8000 {
			flush_interval -1
		}
	}
}
