# Copy to .env and fill in:   cp .env.example .env
# (.env is git-ignored; the stack refuses to start until these are set.)

# Internal password Liquidsoap uses to publish to Icecast (never typed in a
# browser; Icecast isn't reachable from outside).
PASSWORD=change-me

# Admin site at /admin (user "admin"): SoundExchange reports.
ADMIN_PASSWORD=change-me-admin

# Station name: the wordmark (lowercased) and browser tab titles.
SITE_TITLE=Mazes Radio

# Optional contact address shown on the About page.
CONTACT_EMAIL=

# Optional password for the show pages (a login form; the streams stay public).
# Leave empty for a public site.
SITE_PASSWORD=

# Your domain; Caddy gets a trusted Let's Encrypt certificate automatically.
# Leave commented out to run on https://localhost.
#DOMAIN=radio.example.com

# Time zone for the play log, page times and monthly reports.
#TZ=America/New_York

# Most connections Icecast takes at once, across all stations (each listener
# needs 256 kbps of upload bandwidth, so 100 listeners need about 26 Mbps).
#MAX_LISTENERS=100
